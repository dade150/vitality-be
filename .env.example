# Copia in .env (che NON va committato). Nessun valore sensibile qui.
ENVIRONMENT=dev
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Provider LLM: echo (nessuna credenziale) | vertex
LLM_PROVIDER=echo

# --- solo con LLM_PROVIDER=vertex ---
GCP_PROJECT=
GCP_LOCATION=eu
LLM_MODEL=
# In locale: gcloud auth application-default login
# Su Render: GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/<file> (secret file)

# --- opzionali (default sensati) ---
# LLM_TIMEOUT_S=40
# LLM_MAX_OUTPUT_TOKENS=2048
# LLM_TEMPERATURE=0.3
# LLM_THINKING_LEVEL=low
# CHAT_REQUEST_TIMEOUT_S=50
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW_S=60
# LLM_MAX_CONCURRENCY=8
# LLM_QUEUE_TIMEOUT_S=5
# MAX_BODY_BYTES=65536
# ALLOWED_HOSTS=api.example.com,localhost
