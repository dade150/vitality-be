ENVIRONMENT=dev

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_UPSERT_BATCH_SIZE=100

# Provider LLM: echo (nessuna credenziale) | vertex
LLM_PROVIDER=vertex

# --- solo con LLM_PROVIDER=vertex ---
GCP_PROJECT=vitality-assist
GCP_LOCATION=europe-west1
LLM_MODEL=gemini-2.5-flash
# In locale: gcloud auth application-default login
# Su Render: GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/<file> (secret file)

# --- opzionali (default sensati) ---
# LLM_TIMEOUT_S=40
# LLM_MAX_OUTPUT_TOKENS=2048
# LLM_TEMPERATURE=0.3
# LLM_THINKING_LEVEL=low
# CHAT_REQUEST_TIMEOUT_S=50
# RATE_LIMIT_REQUESTS=20
# RATE_LIMIT_WINDOW_S=60
# LLM_MAX_CONCURRENCY=8
# LLM_QUEUE_TIMEOUT_S=5
# MAX_BODY_BYTES=65536

ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2


EMBEDDING_GCP_PROJECT=vitality-assist
EMBEDDING_LOCATION=eu
EMBEDDING_API_ENDPOINT=https://aiplatform.eu.rep.googleapis.com
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_CONCURRENCY=2


# --- Pipeline corpus ---
CORPUS_DIR=curated
CHUNKS_OUTPUT_DIR=output/chunks
EMBEDDINGS_OUTPUT_DIR=output/embeddings
CHUNK_MAX_CHARS=3000
CHUNK_OVERLAP_CHARS=0

SUPABASE_SERVICE_ROLE_KEY=